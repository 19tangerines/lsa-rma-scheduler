# Server-only Supabase credentials. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Generate this with: npm run admin:hash-pin -- 1234
ADMIN_PIN_HASH=pbkdf2:100000:REPLACE_ME:REPLACE_ME

# Generate a long random value with: npm run admin:session-secret
ADMIN_SESSION_SECRET=REPLACE_ME
